{
  "name": "lexical-solid-repo",
  "workspaces": [
    "lexical-solid",
    "docs"
  ],
  "nohoist": [
    "**/solid-start"
  ],
  "scripts": {
    "copy-readme": "node -e \"require('fs').cpSync('README.md','lexical-solid/README.md')\"",
    "remove-readme-copy": "node -e \"require('fs').rmSync('lexical-solid/README.md')\"",
    "run-publish": "pnpm copy-readme && cd lexical-solid && pnpm build && npm publish && cd .. && pnpm run remove-readme-copy"
  }
}